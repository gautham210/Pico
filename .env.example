# Server-only Vercel Function credentials. Never prefix these with VITE_.
IRCTC_KEY=replace-with-provider-key
APIFY_KEY=replace-with-apify-token
NOBLE_KEY=replace-with-noble-flight-key
AVIATIONSTACK_KEY=replace-with-aviationstack-key
GOOGLE_PLACES_KEY=replace-with-google-places-server-key
GEMINI_API_KEY=replace-with-gemini-api-key
# Optional: GEMINI_MODEL=gemini-2.5-flash
# Optional alternative: OPENAI_API_KEY=replace-with-openai-api-key

# Optional: policy-compliant HTTPS OSM-compatible named-search endpoint.
OSM_PLACES_ENDPOINT=https://provider.example/search

# Optional browser-safe Firebase web configuration (public values only).
VITE_FIREBASE_CONFIG={"apiKey":"replace-me","authDomain":"replace-me","projectId":"replace-me","appId":"replace-me","databaseURL":"https://replace-me"}

# Optional Cloudinary cloud name for the existing unsigned upload preset.
VITE_CLOUDINARY_URL=replace-me
