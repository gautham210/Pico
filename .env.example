# ====================================================================
# Pico Travel Companion - Environment Variables Template
# Copy this file to .env and provide your credentials.
# Never commit actual secret keys or tokens to Git.
# ====================================================================

# 1. Supabase Foundation (Pico 2.0 / 2.2 Auth, Postgres, Realtime, Storage)
# Required for cloud synchronization, user authentication, and Ride Together multiplayer
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-server-only

# 2. Server-Side AI Planning Engine
# Required for Gemini or OpenAI LLM itinerary generation
GEMINI_API_KEY=your-gemini-api-key
# Optional: GEMINI_MODEL=gemini-2.5-flash
# Optional alternative: OPENAI_API_KEY=your-openai-api-key

# 3. Live Weather Service
# Optional OpenWeatherMap API key for live climate and advisory feeds
OPENWEATHER_KEY=your-openweather-api-key

# 4. Places & Mapping Providers
# Optional: policy-compliant HTTPS OSM-compatible named-search endpoint.
OSM_PLACES_ENDPOINT=https://provider.example/search
GOOGLE_PLACES_KEY=your-google-places-server-key

# 5. Transport API Adapters (Server-Only)
IRCTC_KEY=your-irctc-provider-key
APIFY_KEY=your-apify-token
NOBLE_KEY=your-noble-flight-key
AVIATIONSTACK_KEY=your-aviationstack-key

# 6. Legacy / Optional Fallbacks
VITE_FIREBASE_CONFIG={"apiKey":"replace-me","authDomain":"replace-me","projectId":"replace-me","appId":"replace-me"}
VITE_CLOUDINARY_URL=your-cloudinary-url
